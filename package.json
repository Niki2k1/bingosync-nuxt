{
  "name": "bingosync",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "Collaborative bingo boards for speedrunning, rebuilt with Nuxt",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "games:sync": "python3 scripts/sync-games.py",
    "test": "vitest run",
    "typecheck": "nuxt typecheck",
    "deploy": "nuxt build && wervt deploy"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.1",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.1",
    "@wervt/nuxt": "^0.1.0",
    "drizzle-orm": "1.0.0-rc.4",
    "nuxt": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.5.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.130",
    "@types/node": "^26.5.0",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
